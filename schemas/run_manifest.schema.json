{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univ-studymachine:v1:run_manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "filename",
          "source_ids",
          "status"
        ]
      }
    },
    "generation_policy": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "status",
    "artifacts",
    "generation_policy",
    "limitations",
    "validation"
  ]
}
