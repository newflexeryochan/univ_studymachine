{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:univ-studymachine:v1:generation_policy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "allowed": {
      "type": "boolean"
    },
    "consent": {
      "enum": [
        "yes",
        "no",
        null
      ]
    },
    "historical_present": {
      "type": "boolean"
    },
    "unreadable_history": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "allowed",
    "consent",
    "historical_present",
    "unreadable_history",
    "reason"
  ]
}
